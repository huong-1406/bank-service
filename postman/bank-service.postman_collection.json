      "item": [
        {
          "name": "API 2 ✅ Đăng ký tài khoản mới",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = Date.now().toString();",
                  "pm.collectionVariables.set(\"email\", \"pm\" + t + \"@test.com\");",
                  "pm.collectionVariables.set(\"phone\", \"08\" + t.slice(-8));",
                  "pm.collectionVariables.set(\"newPhone\", \"07\" + t.slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Mã HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Không trả mật khẩu\", () => pm.expect(pm.response.json()).to.not.have.property(\"password\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts"
              ]
            },
            "description": "Mỗi lần chạy tạo email và SĐT mới, nên chạy lại bao nhiêu lần cũng được.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Postman Test\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phone}}\",\n  \"password\": \"Test@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
